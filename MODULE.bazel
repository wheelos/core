module(
    name = "wheelos_core",
    version = "1.0.6",
    compatibility_level = 1,
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "pybind11_bazel", version = "3.0.1")
bazel_dep(name = "rules_python", version = "2.4.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.10",
)

bazel_dep(name = "platforms", version = "1.1.0")

# Protobuf 36.2 requires Abseil compatibility level 1; newer releases use 0.
bazel_dep(name = "abseil-cpp", version = "20260107.1", repo_name = "com_google_absl")
bazel_dep(name = "gflags", version = "2.3.1", repo_name = "com_github_gflags_gflags")
bazel_dep(name = "glog", version = "0.7.1.bcr.1", repo_name = "com_github_google_glog")

# GoogleTest 1.18 selects the incompatible Abseil compatibility level 0.
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "com_google_googletest")
bazel_dep(name = "protobuf", version = "36.2", repo_name = "com_google_protobuf")
bazel_dep(name = "flatbuffers", version = "25.12.19.bcr.1")
bazel_dep(name = "zlib", version = "1.3.2.bcr.2")
bazel_dep(name = "ncurses", version = "6.4.20221231.bcr.12")
bazel_dep(name = "libuuid", version = "2.41.2.bcr.0")
bazel_dep(name = "wheelos_fastcdr", version = "2.2.7.bcr.1", repo_name = "fastcdr")
bazel_dep(name = "wheelos_fastdds", version = "2.14.6.bcr.5", repo_name = "fastdds")
bazel_dep(name = "iceoryx", version = "2.95.4")
bazel_dep(name = "liburing", version = "2.15")
bazel_dep(name = "yaml-cpp", version = "0.9.0.bcr.1")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.toolkit(
    name = "cuda",
    toolkit_path = "/usr/local/cuda",
)
use_repo(cuda, "cuda")
